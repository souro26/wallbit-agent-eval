{
  "name": "wallbit-agent-eval",
  "version": "0.1.0",
  "description": "Independent evaluation harness for AI agents interacting with Wallbit's public financial API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    }
  },
  "bin": {
    "wallbit-agent-eval": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --testTimeout 15000",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "cli": "node dist/cli.js",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:start": "npm --prefix web run start",
    "web:lint": "npm --prefix web run lint"
  },
  "keywords": [
    "wallbit",
    "agent",
    "evaluation",
    "testing",
    "financial-api",
    "openclaw"
  ],
  "author": "Souradeep Roy",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "fastify": "^4.24.0",
    "uuid": "^9.0.0",
    "yaml": "^2.3.0"
  }
}
